# ===== LLM(必填后即为真实分析模式;不填则为演示模式)=====
# 兼容 OpenAI Chat Completions 协议的任意供应商,每个人使用前自己填写
# 示例: 智谱 https://open.bigmodel.cn/api/paas/v4
#       DeepSeek https://api.deepseek.com
#       高校自建(如东南大学 aicloud)https://openapi.seu.edu.cn/v1(需校园网/VPN)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.6

# 可选:供应商特定的额外请求体(JSON)。值为 null 的键会从默认请求体中移除。
# 例(高校 qwen 部署): {"response_format": null, "enable_thinking": false}
LLM_EXTRA_BODY=

# ===== Supabase(M3:填入后自动从本地模式切换为 SaaS 登录模式)=====
# 不填 = 本地自用模式(数据存 .data/,无需登录)。接入步骤见 README「Supabase 接入」。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 服务端专用(邀请码校验/LLM 用量计数/内测开通方案),不要暴露到客户端
SUPABASE_SERVICE_ROLE_KEY=

# ===== 可选:SaaS 免费档 LLM 月度限额(默认 60 次/自然月,Pro/Lab 不限)=====
# 需先执行 supabase/migration.sql 建 llm_usage 表(2026-10 后的版本已含)
FREE_LLM_MONTHLY_LIMIT=60
